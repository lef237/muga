// Implemented structured task scope: group, spawn, and std::task join.
// The join calls need package mode with `import std::task`.

group {
  user_task = spawn fetch_user(id)
  orders_task = spawn fetch_orders(id)
  profile_task = spawn fetch_profile(id)

  Page {
    user: user_task.task::join()
    orders: orders_task.task::join()
    profile: profile_task.task::join()
  }
}
