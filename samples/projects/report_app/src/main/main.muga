import report_shared::reports
import std::cli
import std::env
import std::fs
import std::io
import std::path

fn default_output_path(): path::Path {
  home = match "HOME".env::get_var() {
    Option::Some(value) => value
    Option::None => "."
  }
  home.path::from_string().path::join("tmp").path::join("muga-report-app-summary.txt")
}

fn ensure_parent(file_path: path::Path): Result[Unit, io::IOError] {
  match file_path.path::parent() {
    Option::Some(parent) => parent.fs::create_dir_all_path()
    Option::None => Result::Ok(())
  }
}

fn write_report(file_path: path::Path, text: String): Result[Unit, io::IOError] {
  using file = try file_path.fs::create_text() {
    wrote = try file.fs::write_text_to(text)
    flushed = try file.fs::flush()
  }
  Result::Ok(())
}

fn main(): Result[String, io::IOError] {
  args = env::args()
  input = args.cli::positional_or(0, "samples/projects/report_app/data/daily.txt").path::from_string()
  output = args.cli::positional_or(1, default_output_path().path::as_string()).path::from_string()
  made_parent = try output.ensure_parent()
  report = try input.reports::load_report()
  summary = report.reports::summarize()
  rendered = summary.reports::render_summary(input.path::as_string())
  wrote = try output.write_report(rendered)
  printed = summary.println()
  warned = "wrote report ".concat(output.path::as_string()).eprintln()
  missing = "samples/projects/report_app/data/missing.txt".path::from_string()
  Result::Ok(summary.concat("|").concat(missing.reports::error_operation()).concat("|").concat(args.len().to_string()))
}
