import std::cli
import std::env
import std::result
import std::string

pub enum Action {
  Audit
  Apply
}

@cli(about: "Run a typed strict CLI tool")
pub record Root {
  @cli(name: "profile", short: "p", help: "Execution profile")
  profile: Option[String]
  @cli(subcommand)
  command: Command
}

@cli(about: "Run a typed strict CLI tool")
pub enum Command {
  @cli(name: "run", alias: "r", about: "Run the main action")
  Run(RunCommand)
  @cli(name: "inspect", alias: "i", about: "Inspect one target")
  Inspect(InspectCommand)
}

@cli(about: "Run the main action")
pub record RunCommand {
  @cli(positional: 1, help: "Target resource name")
  @validate(non_empty)
  target: String
  @cli(name: "count", short: "c", help: "Number of items to process")
  @validate(min: 1, max: 10)
  count: Int
  @cli(short: "a", help: "Command action")
  action: Action
  @cli(name: "dry-run", short: "d", help: "Preview changes without applying them")
  dry_run: Bool
  @cli(name: "tag", short: "T", alias: "tags", help: "Tag filter")
  tags: List[String]
  @cli(short: "o", help: "Optional owner")
  owner: Option[String]
}

@cli(about: "Inspect one target")
pub record InspectCommand {
  @cli(positional: 1, help: "Target resource name")
  @validate(non_empty)
  target: String
  @cli(short: "v", help: "Show verbose inspection details")
  verbose: Bool
}

fn action_text(action: Action): String {
  match action {
    Action::Audit => "Audit"
    Action::Apply => "Apply"
  }
}

fn option_text(value: Option[String]): String {
  match value {
    Option::Some(text) => text
    Option::None => "none"
  }
}

fn tags_text(tags: List[String]): String {
  if tags.len() == 0 {
    "none"
  } else {
    tags.string::join(",")
  }
}

fn render_run(command: RunCommand): String {
  ["run", command.target, command.count.to_string(), command.action.action_text(), command.dry_run.to_string(), command.tags.tags_text(), command.owner.option_text()].string::join("|")
}

fn render_inspect(command: InspectCommand): String {
  ["inspect", command.target, command.verbose.to_string()].string::join("|")
}

fn render_command(command: Command): String {
  match command {
    Command::Run(run_options) => run_options.render_run()
    Command::Inspect(inspect_command) => inspect_command.render_inspect()
  }
}

fn render_root(root: Root): String {
  rendered = root.command.render_command()
  match root.profile {
    Option::Some(profile) => ["profile", profile, rendered].string::join("|")
    Option::None => rendered
  }
}

fn cli_error_kind_name(kind: cli::ErrorKind): String {
  match kind {
    cli::ErrorKind::UnknownArgument => "UnknownArgument"
    cli::ErrorKind::MissingArgument => "MissingArgument"
    cli::ErrorKind::MissingValue => "MissingValue"
    cli::ErrorKind::InvalidValue => "InvalidValue"
    cli::ErrorKind::Validation => "Validation"
    cli::ErrorKind::UnsupportedTarget => "UnsupportedTarget"
  }
}

fn cli_error_message(error: cli::Error): String {
  ["cli ", error.kind.cli_error_kind_name(), " ", error.argument, ": ", error.message].string::concat_all()
}

fn emit_usage(usage: String): Result[String, String] {
  printed = usage.println()
  Result::Ok(usage)
}

fn run_command(root: Root): Result[String, String] {
  rendered = root.render_root()
  printed = ["cli-tool ", rendered].string::concat_all().println()
  Result::Ok(rendered)
}

fn main(): Result[String, String] {
  args = env::args()
  request = try cli::parse_request[Root](args, "cli-tool").result::map_err(cli_error_message)
  match request {
    cli::Request::Help(usage) => usage.emit_usage()
    cli::Request::Parsed(root) => root.run_command()
  }
}
