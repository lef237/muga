import std::task

record Profile {
  label: String
  score: Int
}

fn fetch_label(id: Int): String {
  "user-".concat(id.to_string())
}

fn fetch_score(id: Int): Int {
  id * 7
}

fn main(): String {
  group {
    label_task = spawn 3.fetch_label()
    score_task = spawn 3.fetch_score()
    profile = Profile { label: label_task.task::join(), score: score_task.task::join() }
    profile.label.concat("/".concat(profile.score.to_string()))
  }
}
