import std::bytes
import std::cli
import std::env
import std::fs
import std::hash
import std::io
import std::path

fn kind_name(kind: fs::PathKind): String {
  match kind {
    fs::PathKind::Missing => "missing"
    fs::PathKind::File => "file"
    fs::PathKind::Directory => "directory"
    fs::PathKind::Other => "other"
  }
}

fn default_export_path(): Result[path::Path, io::IOError] {
  tmp_dir = try env::temp_dir()
  Result::Ok(tmp_dir.path::join("muga-resource-export-payload.bin"))
}

fn export_path(): Result[path::Path, io::IOError] {
  default_path = try default_export_path()
  Result::Ok(env::args().cli::positional_or(0, default_path.path::as_string()).path::from_string())
}

fn render_result(size: Int, metadata: fs::PathMetadata, digest: String): String {
  size.to_string().concat("|").concat(metadata.kind.kind_name()).concat("|").concat(metadata.status.is_file.to_string()).concat("|").concat(digest)
}

fn main(): Result[String, io::IOError] {
  data = try "resource_export".fs::read_resource_bytes("static/payload.bin")
  digest = data.hash::sha256_hex()
  target = try export_path()
  wrote = try target.fs::write_bytes_path(data)
  metadata = try target.fs::path_metadata_path()
  written = try target.fs::read_bytes_path()
  removed = try target.fs::remove_file_path()
  Result::Ok(written.bytes::size().render_result(metadata, digest))
}
