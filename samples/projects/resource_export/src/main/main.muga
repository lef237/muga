import std::bytes
import std::cli
import std::env
import std::fs
import std::hash
import std::io
import std::path

fn kind_name(kind: fs::PathKind): String {
  match kind {
    fs::PathKind::Missing => "missing"
    fs::PathKind::File => "file"
    fs::PathKind::Directory => "directory"
    fs::PathKind::Other => "other"
  }
}

fn default_export_path(): Result[path::Path, io::IOError] {
  tmp_dir = try env::temp_dir()
  Result::Ok(path::join(tmp_dir, "muga-resource-export-payload.bin"))
}

fn export_path(): Result[path::Path, io::IOError] {
  default_path = try default_export_path()
  Result::Ok(path::from_string(cli::positional_or(env::args(), 0, path::as_string(default_path))))
}

fn render_result(size: Int, metadata: fs::PathMetadata, digest: String): String {
  size.to_string().concat("|").concat(kind_name(metadata.kind)).concat("|").concat(metadata.status.is_file.to_string()).concat("|").concat(digest)
}

fn main(): Result[String, io::IOError] {
  data = try fs::read_resource_bytes("resource_export", "static/payload.bin")
  digest = hash::sha256_hex(data)
  target = try export_path()
  wrote = try fs::write_bytes_path(target, data)
  metadata = try fs::path_metadata_path(target)
  written = try fs::read_bytes_path(target)
  removed = try fs::remove_file_path(target)
  Result::Ok(render_result(bytes::size(written), metadata, digest))
}
