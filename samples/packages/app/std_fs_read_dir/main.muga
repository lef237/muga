package app::std_fs_read_dir

import std::fs
import std::io
import std::path

fn main(): Result[String, io::IOError] {
  dir_path = "samples/packages/app/std_fs_read_dir".path::from_string()
  entries = try dir_path.fs::read_dir_path()
  match entries.get(0) {
    Option::Some(value) => Result::Ok(value.path::as_string())
    Option::None => Result::Ok("missing")
  }
}
