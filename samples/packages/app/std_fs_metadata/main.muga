package app::std_fs_metadata

import std::fs
import std::path

fn kind_name(kind: fs::PathKind): String {
  match kind {
    fs::PathKind::Missing => "missing"
    fs::PathKind::File => "file"
    fs::PathKind::Directory => "directory"
    fs::PathKind::Other => "other"
  }
}

fn main(): String {
  source = "samples/packages/app/std_fs_metadata/main.muga".path::from_string()
  folder = "samples/packages/app/std_fs_metadata".path::from_string()
  missing = "samples/packages/app/std_fs_metadata/missing.txt".path::from_string()
  source_status: fs::PathStatus = source.fs::path_status()
  folder_status = folder.fs::path_status()
  source_info = source.fs::path_info()
  folder_info = folder.fs::path_info()
  missing_info = missing.fs::path_info()
  missing_status = missing_info.status
  first = source_info.kind.kind_name().concat("/").concat(source_status.is_file.to_string())
  second = first.concat("/").concat(folder_info.kind.kind_name()).concat("/").concat(folder_status.is_dir.to_string())
  second.concat("/").concat(missing_info.kind.kind_name()).concat("/").concat(missing_status.exists.to_string())
}
