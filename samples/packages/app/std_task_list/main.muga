package app::std_task_list

import std::task
import std::list

fn work(n: Int): Int {
  n * 2
}

fn main(): Int {
  group {
    tasks = [spawn 1.work(), spawn 2.work(), spawn 3.work()]
    results = tasks.list::map(fn(item) {
      item.task::join()
    })
    results.list::fold(0, fn(total, item) {
      total + item
    })
  }
}
