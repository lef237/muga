package app::std_fs_modified_time

import std::fs
import std::path

fn main(): String {
  target = "samples/packages/app/std_fs_modified_time/main.muga".path::from_string()
  match target.fs::modified_unix_millis_path() {
    Result::Ok(modified) => if modified.value > 0 {
      "ok"
    } else {
      "invalid"
    }
    Result::Err(error) => error.operation
  }
}
