package app::std_fs_path_metadata

import std::fs
import std::io
import std::path

fn kind_name(kind: fs::PathKind): String {
  match kind {
    fs::PathKind::Missing => "missing"
    fs::PathKind::File => "file"
    fs::PathKind::Directory => "directory"
    fs::PathKind::Other => "other"
  }
}

fn main(): Result[String, io::IOError] {
  source = "samples/packages/app/std_fs_path_metadata/main.muga".path::from_string()
  folder = "samples/packages/app/std_fs_path_metadata".path::from_string()
  source_metadata: fs::PathMetadata = try source.fs::path_metadata_path()
  folder_metadata = try folder.fs::path_metadata_path()
  modified_text = source_metadata.modified.value.to_string()
  first = source_metadata.kind.kind_name().concat("/").concat(source_metadata.status.is_file.to_string())
  second = first.concat("/").concat(folder_metadata.kind.kind_name()).concat("/").concat(folder_metadata.status.is_dir.to_string())
  Result::Ok(second.concat("/").concat(modified_text.is_empty().to_string()))
}
