package app::std_fs_path_metadata

import std::fs
import std::io
import std::path

fn kind_name(kind: fs::PathKind): String {
  match kind {
    fs::PathKind::Missing => "missing"
    fs::PathKind::File => "file"
    fs::PathKind::Directory => "directory"
    fs::PathKind::Other => "other"
  }
}

fn main(): Result[String, io::IOError] {
  source = path::from_string("samples/packages/app/std_fs_path_metadata/main.muga")
  folder = path::from_string("samples/packages/app/std_fs_path_metadata")
  source_metadata: fs::PathMetadata = try fs::path_metadata_path(source)
  folder_metadata = try fs::path_metadata_path(folder)
  modified_text = source_metadata.modified.value.to_string()
  first = kind_name(source_metadata.kind).concat("/").concat(source_metadata.status.is_file.to_string())
  second = first.concat("/").concat(kind_name(folder_metadata.kind)).concat("/").concat(folder_metadata.status.is_dir.to_string())
  Result::Ok(second.concat("/").concat(modified_text.is_empty().to_string()))
}
