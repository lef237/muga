package app::std_json

import std::json

fn encode_config(name: String, score: Int, active: Bool): Result[String, json::Error] {
  fields: Map[String, json::Value] = Map.empty()
  value = json::Value::Object(fields.insert("active", json::Value::Bool(active)).insert("name", json::Value::String(name)).insert("score", score.json::int()))
  value.json::encode()
}

fn main(): Result[String, json::Error] {
  parsed = try "{\"name\":\"Ada\",\"score\":42,\"active\":true,\"items\":[1,2],\"tags\":[\"tool\",\"service\"],\"meta\":{\"team\":\"core\",\"labels\":[\"runtime\",\"json\"]}}".json::parse()
  name = try parsed.json::object_string_required("name")
  score = try parsed.json::object_int_required("score")
  active = try parsed.json::object_bool_required("active")
  label = try parsed.json::object_string_or("label", "default")
  item_ints = try parsed.json::object_int_array_required("items")
  tags = try parsed.json::object_string_array_required("tags")
  empty_items: List[json::Value] = []
  fallback_items = try parsed.json::object_array_or("fallback_items", empty_items)
  meta = try parsed.json::object_object_required("meta")
  empty_meta: Map[String, json::Value] = Map.empty()
  fallback_meta = try parsed.json::object_object_or("fallback_meta", empty_meta)
  team = try parsed.json::at_string_required([json::PathSegment::Field("meta"), json::PathSegment::Field("team")])
  first_item = try parsed.json::at_int_required([json::PathSegment::Field("items"), json::PathSegment::Index(0)])
  labels = try parsed.json::at_string_array_required([json::PathSegment::Field("meta"), json::PathSegment::Field("labels")])
  encoded = try name.encode_config(score, active)
  Result::Ok(label.concat("|").concat(name).concat("|").concat(score.to_string()).concat("|").concat(active.to_string()).concat("|").concat(item_ints.len().to_string()).concat("|").concat(tags.len().to_string()).concat("|").concat(fallback_items.len().to_string()).concat("|").concat(meta.len().to_string()).concat("|").concat(fallback_meta.len().to_string()).concat("|").concat(team).concat("|").concat(first_item.to_string()).concat("|").concat(labels.len().to_string()).concat("|").concat(encoded))
}
