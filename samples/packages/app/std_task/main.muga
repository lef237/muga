package app::std_task

import std::task

fn fetch_label(id: Int): String {
  "item-".concat(id.to_string())
}

fn fetch_score(id: Int): Int {
  id * 10
}

fn main(): String {
  group {
    label_task = spawn 7.fetch_label()
    score_task = spawn 7.fetch_score()
    label = label_task.task::join()
    score = score_task.task::join()
    label.concat("/".concat(score.to_string()))
  }
}
