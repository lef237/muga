package app::std_fs_path_size_metadata

import std::fs
import std::io
import std::path

fn kind_name(kind: fs::PathKind): String {
  match kind {
    fs::PathKind::Missing => "missing"
    fs::PathKind::File => "file"
    fs::PathKind::Directory => "directory"
    fs::PathKind::Other => "other"
  }
}

fn size_text(size: Option[Int]): String {
  match size {
    Option::Some(value) => value.to_string()
    Option::None => "none"
  }
}

fn main(): Result[String, io::IOError] {
  source = "samples/packages/app/std_hash/payload.bin".path::from_string()
  folder = "samples/packages/app/std_fs_path_size_metadata".path::from_string()
  source_metadata: fs::PathSizeMetadata = try source.fs::path_size_metadata_path()
  folder_metadata = try folder.fs::path_size_metadata_path()
  modified_text = source_metadata.modified.value.to_string()
  first = source_metadata.kind.kind_name().concat("/").concat(source_metadata.status.is_file.to_string()).concat("/").concat(source_metadata.size.size_text())
  second = first.concat("/").concat(folder_metadata.kind.kind_name()).concat("/").concat(folder_metadata.status.is_dir.to_string()).concat("/").concat(folder_metadata.size.size_text())
  Result::Ok(second.concat("/").concat(modified_text.is_empty().to_string()))
}
