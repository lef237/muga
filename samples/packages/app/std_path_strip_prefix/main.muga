package app::std_path_strip_prefix

import std::path

fn main(): String {
  source = "reports/2026/daily.txt".path::from_string()
  base = "reports".path::from_string()
  match source.path::strip_prefix(base) {
    Option::Some(relative) => relative.path::as_string()
    Option::None => "missing"
  }
}
