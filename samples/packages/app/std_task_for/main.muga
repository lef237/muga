package app::std_task_for

import std::task
import std::list

fn announce(label: String): String {
  "done:".concat(label).println()
}

fn main(): Int {
  labels = ["a", "b", "c"]
  group {
    for label in labels {
      spawn label.announce()
    }
    labels.list::fold(0, fn(total, label) {
      total + 1
    })
  }
}
