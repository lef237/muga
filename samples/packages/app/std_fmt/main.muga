package app::std_fmt

import std::fmt
import std::string

fn main(): String {
  ruler = "-".fmt::repeat(3)
  left = "Muga".fmt::pad_left(7, ".")
  right = "go".fmt::pad_right(5, "*")
  clipped = "abcdef".fmt::truncate_chars(4)
  empty = "abcdef".fmt::truncate_chars(0)
  rendered = match "{} {{ok}} {}".fmt::format_values(["Muga", "fmt"]) {
    Result::Ok(value) => value
    Result::Err(error) => "format error"
  }
  [ruler, left, right, clipped, empty, rendered].string::join("|")
}
