package app::std_fs_copy_dir_all

import std::fs
import std::path

fn copied_payload_summary(base: path::Path, target: path::Path): String {
  copied_payload = target.path::join("nested").path::join("payload.txt")
  text = match copied_payload.fs::read_text_path() {
    Result::Ok(value) => value
    Result::Err(error) => error.operation
  }
  removed = match base.fs::remove_dir_all_path() {
    Result::Ok(value) => true
    Result::Err(error) => false
  }
  text.concat("|").concat(removed.to_string()).concat("|").concat(base.fs::exists_path().to_string())
}

fn main(): String {
  base = "samples/packages/app/std_fs_copy_dir_all/generated".path::from_string()
  source = base.path::join("source")
  nested = source.path::join("nested")
  target = base.path::join("target")
  payload = nested.path::join("payload.txt")
  match nested.fs::create_dir_all_path() {
    Result::Ok(created) => match payload.fs::write_text_path("payload") {
      Result::Ok(written) => match source.fs::copy_dir_all_path(target) {
        Result::Ok(copied) => base.copied_payload_summary(target)
        Result::Err(error) => error.operation
      }
      Result::Err(error) => error.operation
    }
    Result::Err(error) => error.operation
  }
}
