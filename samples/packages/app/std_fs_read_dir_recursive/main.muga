package app::std_fs_read_dir_recursive

import std::fs
import std::io
import std::path

fn relative_or_empty(base: path::Path, items: List[path::Path], index: Int): String {
  match items.get(index) {
    Option::Some(value) => match value.path::strip_prefix(base) {
      Option::Some(relative) => relative.path::as_string()
      Option::None => value.path::as_string()
    }
    Option::None => ""
  }
}

fn main(): Result[String, io::IOError] {
  root = "samples/packages/app/std_fs_read_dir_recursive".path::from_string()
  entries = try root.fs::read_dir_recursive_path()
  first = root.relative_or_empty(entries, 0)
  third = root.relative_or_empty(entries, 2)
  Result::Ok(first.concat("|").concat(third).concat("|").concat(entries.len().to_string()))
}
