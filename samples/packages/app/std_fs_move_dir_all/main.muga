package app::std_fs_move_dir_all

import std::fs
import std::path

fn moved_payload_summary(base: path::Path, source: path::Path, target: path::Path): String {
  moved_payload = target.path::join("nested").path::join("payload.txt")
  text = match moved_payload.fs::read_text_path() {
    Result::Ok(value) => value
    Result::Err(error) => error.operation
  }
  source_exists = source.fs::exists_path()
  target_exists = target.fs::exists_path()
  removed = match base.fs::remove_dir_all_path() {
    Result::Ok(value) => true
    Result::Err(error) => false
  }
  text.concat("|").concat(source_exists.to_string()).concat("|").concat(target_exists.to_string()).concat("|").concat(base.fs::exists_path().to_string())
}

fn main(): String {
  base = "samples/packages/app/std_fs_move_dir_all/generated".path::from_string()
  source = base.path::join("source")
  nested = source.path::join("nested")
  target = base.path::join("target")
  payload = nested.path::join("payload.txt")
  match nested.fs::create_dir_all_path() {
    Result::Ok(created) => match payload.fs::write_text_path("payload") {
      Result::Ok(written) => match source.fs::move_dir_all_path(target) {
        Result::Ok(moved) => base.moved_payload_summary(source, target)
        Result::Err(error) => error.operation
      }
      Result::Err(error) => error.operation
    }
    Result::Err(error) => error.operation
  }
}
