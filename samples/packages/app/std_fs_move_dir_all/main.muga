package app::std_fs_move_dir_all

import std::fs
import std::path

fn moved_payload_summary(base: path::Path, source: path::Path, target: path::Path): String {
  moved_payload = path::join(path::join(target, "nested"), "payload.txt")
  text = match fs::read_text_path(moved_payload) {
    Result::Ok(value) => value
    Result::Err(error) => error.operation
  }
  source_exists = fs::exists_path(source)
  target_exists = fs::exists_path(target)
  removed = match fs::remove_dir_all_path(base) {
    Result::Ok(value) => true
    Result::Err(error) => false
  }
  text.concat("|").concat(source_exists.to_string()).concat("|").concat(target_exists.to_string()).concat("|").concat(fs::exists_path(base).to_string())
}

fn main(): String {
  base = path::from_string("samples/packages/app/std_fs_move_dir_all/generated")
  source = path::join(base, "source")
  nested = path::join(source, "nested")
  target = path::join(base, "target")
  payload = path::join(nested, "payload.txt")
  match fs::create_dir_all_path(nested) {
    Result::Ok(created) => match fs::write_text_path(payload, "payload") {
      Result::Ok(written) => match fs::move_dir_all_path(source, target) {
        Result::Ok(moved) => moved_payload_summary(base, source, target)
        Result::Err(error) => error.operation
      }
      Result::Err(error) => error.operation
    }
    Result::Err(error) => error.operation
  }
}
