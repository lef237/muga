package app::std_task_result

import std::task

fn parse_positive(label: String, n: Int): Result[Int, String] {
  if n > 0 {
    Result::Ok(n)
  } else {
    Result::Err(concat(label, " must be positive"))
  }
}

fn main(): Result[Int, String] {
  group {
    a_task = spawn parse_positive("a", 2)
    b_task = spawn parse_positive("b", 3)
    a = try a_task.task::join()
    b = try task::join(b_task)
    Result::Ok(a + b)
  }
}
