package app::std_hash

import std::bytes
import std::fs
import std::hash
import std::io

fn main(): Result[String, io::IOError] {
  data = try fs::read_bytes("samples/packages/app/std_hash/payload.bin")
  first = match bytes::at(data, 0) {
    Option::Some(value) => value
    Option::None => 0
  }
  digest = hash::sha256_hex(data)
  Result::Ok(bytes::size(data).to_string().concat("|").concat(first.to_string()).concat("|").concat(digest))
}
