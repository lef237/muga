package app::std_hash

import std::bytes
import std::fs
import std::hash
import std::io

fn main(): Result[String, io::IOError] {
  data = try "samples/packages/app/std_hash/payload.bin".fs::read_bytes()
  first = match data.bytes::at(0) {
    Option::Some(value) => value
    Option::None => 0
  }
  digest = data.hash::sha256_hex()
  Result::Ok(data.bytes::size().to_string().concat("|").concat(first.to_string()).concat("|").concat(digest))
}
