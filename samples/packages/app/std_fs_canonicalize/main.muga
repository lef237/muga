package app::std_fs_canonicalize

import std::fs
import std::path

fn main(): String {
  source = "samples/packages/app/std_fs_canonicalize/main.muga".path::from_string()
  match source.fs::canonicalize_path() {
    Result::Ok(resolved) => match resolved.path::file_name() {
      Option::Some(name) => name
      Option::None => "missing"
    }
    Result::Err(error) => error.operation
  }
}
