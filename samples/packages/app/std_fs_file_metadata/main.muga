package app::std_fs_file_metadata

import std::fs
import std::path

fn main(): String {
  file_path = "samples/packages/app/std_hash/payload.bin".path::from_string()
  match file_path.fs::file_metadata_path() {
    Result::Ok(metadata) => metadata.size.to_string().concat("/").concat(if metadata.modified.value > 0 {
      "ok"
    } else {
      "invalid"
    })
    Result::Err(error) => error.operation
  }
}
