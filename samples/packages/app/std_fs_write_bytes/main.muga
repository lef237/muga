package app::std_fs_write_bytes

import std::bytes
import std::env
import std::fs
import std::io
import std::path

fn main(): Result[String, io::IOError] {
  data = try fs::read_bytes("samples/packages/app/std_hash/payload.bin")
  tmp_dir = try env::temp_dir()
  target = path::join(tmp_dir, "muga-std-fs-write-bytes-sample.bin")
  done = try fs::write_bytes_path(target, data)
  written = try fs::read_bytes_path(target)
  removed = try fs::remove_file_path(target)
  Result::Ok(bytes::size(written).to_string())
}
