package app::std_fs_rename

import std::fs
import std::path

fn main(): String {
  source = "samples/packages/app/std_fs_rename/missing.txt".path::from_string()
  target = "samples/packages/app/std_fs_rename/renamed.txt".path::from_string()
  match source.fs::rename_path(target) {
    Result::Ok(value) => "renamed"
    Result::Err(error) => error.operation
  }
}
