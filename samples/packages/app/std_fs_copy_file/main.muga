package app::std_fs_copy_file

import std::fs
import std::path

fn main(): String {
  source = "samples/packages/app/std_fs_copy_file/missing.txt".path::from_string()
  target = "samples/packages/app/std_fs_copy_file/copied.txt".path::from_string()
  match source.fs::copy_file_path(target) {
    Result::Ok(value) => "copied"
    Result::Err(error) => error.operation
  }
}
