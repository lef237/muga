package util::numbers

pub fn singleton(x: Int): List[Int] {
  [x]
}

pub fn singleton_len(x: Int): Int {
  x.singleton().len()
}

pub fn singleton_first(x: Int): Int {
  x.singleton()[0]
}

pub fn singleton_get(x: Int): Option[Int] {
  x.singleton().get(0)
}

pub fn empty_get(): Option[Int] {
  [].get(0)
}

pub fn replace_singleton(x: Int, value: Int): List[Int] {
  x.singleton().set(0, value)
}
