fn main(): String {
  text = "  Ada Lovelace  ".trim().replace("Lovelace", "Muga")
  parts = text.split(" ")
  if text.starts_with("Ada") {
    if text.ends_with("Muga") {
      if text.contains("Mu") {
        if "".is_empty() {
          if parts.len() == 2 {
            if text.char_count() == 8 {
              text
            } else {
              "char count failed"
            }
          } else {
            "split failed"
          }
        } else {
          "empty check failed"
        }
      } else {
        "contains failed"
      }
    } else {
      "suffix failed"
    }
  } else {
    "prefix failed"
  }
}
