// conformance: valid
// spec: spec/007-concurrency-draft.md#5-phase-1-structured-task-core-implemented
// expect-main: 42
fn double(n: Int): Int {
  n * 2
}

fn main(): Int {
  base = 40
  group {
    _ = spawn base.double()
    _ = spawn group {
      _ = spawn (base + 1)
      2
    }
    42
  }
}
